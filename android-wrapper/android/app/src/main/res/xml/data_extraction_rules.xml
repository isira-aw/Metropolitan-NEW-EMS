<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) replacement for fullBackupContent. Both cloud backup and
    device-to-device transfer are excluded entirely: the app's data directory holds
    only the WebView storage for the EMS portal, which contains the signed-in user's
    JWT access and refresh tokens. There is no local state worth preserving, and
    exporting that directory would export working credentials.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
