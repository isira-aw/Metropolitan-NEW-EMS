# ====================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES
# ====================================
# Copy this file to .env for local development
# For Railway deployment, set these variables in the Railway dashboard

# ====================================
# BACKEND ENVIRONMENT VARIABLES
# ====================================

# Database Configuration (Railway PostgreSQL)
# Railway automatically provides DATABASE_URL, or use individual variables
# REQUIRED - no insecure default is baked into the app
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ems_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-secure-database-password

# JWT Configuration
# CRITICAL: Generate a strong random secret for production - REQUIRED, no default
# Generate using: openssl rand -base64 64
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MINIMUM-256-BITS
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=86400000

# Active profile - "dev"/"local" seeds default admin/employee accounts for local
# development. Production MUST use a different value (e.g. "prod") so those
# default credentials are never created against a real database.
SPRING_PROFILES_ACTIVE=prod

# Timezone Configuration
# IMPORTANT: Set this to Asia/Colombo for Sri Lankan business operations
# This ensures correct date/time calculations regardless of server location
APP_TIMEZONE=Asia/Colombo

# Email Configuration (Amazon SES)
# SES_SENDER_EMAIL must be a verified SES identity in AWS_REGION.
# AWS credentials themselves (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) come from
# the standard AWS SDK credential chain - set them as env vars only if not using
# an IAM role on the host. Never commit real AWS credentials.
AWS_REGION=us-east-1
SES_SENDER_EMAIL=your-verified-sender@example.com

# WhatsApp API Configuration (Optional)
# Get credentials from Meta for Developers
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=YOUR_CUSTOM_VERIFY_TOKEN

# Application URLs
# Set to your Railway frontend URL for CORS and email links
APP_FRONTEND_URL=https://your-frontend-url.railway.app

# Password Reset Configuration
APP_PASSWORD_RESET_TOKEN_EXPIRY=15

# ====================================
# FRONTEND ENVIRONMENT VARIABLES
# ====================================

# Backend API URL
# Set to your Railway backend URL
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app

# Timezone (should match backend)
NEXT_PUBLIC_TIMEZONE=Asia/Colombo

# ====================================
# RAILWAY-SPECIFIC NOTES
# ====================================
#
# 1. Backend Service:
#    - Build Command: cd back-e && mvn clean package -DskipTests
#    - Start Command: java -jar back-e/target/ems-backend-0.0.1-SNAPSHOT.jar
#    - Port: 8080
#
# 2. Frontend Service:
#    - Build Command: cd front-e && npm install && npm run build
#    - Start Command: cd front-e && npm start
#    - Port: 3000
#
# 3. Database:
#    - Add PostgreSQL plugin from Railway marketplace
#    - Railway will auto-generate DATABASE_URL
#
# 4. Important:
#    - Set all variables in Railway dashboard for each service
#    - Frontend variables must start with NEXT_PUBLIC_ to be exposed to browser
#    - Never commit .env file with real secrets to git
#
# 5. CORS Configuration:
#    - Update APP_FRONTEND_URL to your Railway frontend URL
#    - Backend will use this for CORS configuration
#
# ====================================
