# Copy this file to .env.local for local development.
# For Railway/production, set these in the platform's environment variable settings.

# Backend API base URL. Falls back to http://localhost:8080/api in dev if unset.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Must match the backend's APP_TIMEZONE.
NEXT_PUBLIC_TIMEZONE=Asia/Colombo

# URL of the latest Android APK release asset. Shown as a "Get Android App"
# sidebar link to Android browser visitors only. Leave unset to hide the link.
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://github.com/isira-aw/Metropolitan-NEW-EMS/releases/latest/download/ems-app.apk
